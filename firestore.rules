
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    match /users/{uid} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid;

      allow update, delete: if signedIn()
        && request.auth.uid == uid;
    }

    match /usernames/{username} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == username
        && !exists(
          /databases/$(database)/documents/usernames/$(username)
        );

      allow update, delete: if false;
    }

    match /videos/{videoId} {

      function likePath() {
        return /databases/$(database)/documents/videos/$(videoId)/likes/$(request.auth.uid);
      }

      function validLikeChange() {
        let path = likePath();

        return request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['likesCount'])
          && (
            (!exists(path)
              && existsAfter(path)
              && request.resource.data.likesCount
                == resource.data.likesCount + 1)
            ||
            (exists(path)
              && !existsAfter(path)
              && request.resource.data.likesCount
                == resource.data.likesCount - 1)
          );
      }

      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      allow update: if signedIn()
        && (
          resource.data.userId == request.auth.uid
          || validLikeChange()
        );

      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;

      match /likes/{userId} {
        allow read: if signedIn();

        allow create: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.userId == userId;

        allow delete: if signedIn()
          && request.auth.uid == userId;

        allow update: if false;
      }

      match /comments/{commentId} {
        allow read: if signedIn();

        allow create: if signedIn()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;

        allow delete: if signedIn()
          && resource.data.userId == request.auth.uid;

        allow update: if false;
      }
    }
  }
}
